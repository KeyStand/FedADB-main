{
    "data_setups":{
        "root": "./data",
        "dataset_name": "cifar10",
        "batch_size": 128,
        "n_clients": 100,
       "partition": {
            "method": "lda",
            "alpha": 0.1
        }
    },
    "train_setups":{
        "algo": {
            "name": "fedavg",
            "params": {}
        },
        "scenario": {
            "n_rounds": 1000,
            "sample_ratio": 0.05,
            "local_epochs": 5,
            "device": "cuda:0"
        },
        "model":{
            "name": "res18",
            "params": {}
        },
        "optimizer":{
            "params": {"lr": 0.01, "momentum":0.9, "weight_decay": 1e-5}
        },
        "scheduler":{
            "enabled": true,
            "name": "step",
            "params": {"gamma":0.99, "step_size": 1}
        },
        "seed": 2025
    },
    "wandb_setups":{
        "project": "cifar10_n100_f0.05_D0.1",
        "group": "fedavg",
        "name": "fedavg"
    }
}
